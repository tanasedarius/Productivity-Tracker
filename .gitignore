# ---- Build output (generated by CMake, never commit) ----
cmake-build-debug/
cmake-build-release/
build/
out/
*.o
*.obj
*.exe
*.app

# ---- Generated documentation (Doxygen) ----
# Keep the Doxyfile, ignore the generated site.
docs/html/
docs/latex/

# ---- IDE / editor settings (personal, not part of the project) ----
.idea/
.vscode/
*.user

# ---- Runtime data (created by the app on first run) ----
# Keep the data/ folder itself, but ignore personal runtime files.
data/*
!data/.gitkeep

# ---- OS junk ----
.DS_Store
Thumbs.db

# ---- Misc clutter ----
src/cod_sursa.txt
